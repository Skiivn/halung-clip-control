# ============================================================================
# HALUNG Clip Control — Environment Configuration
# ============================================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env or share the HALUNG_EDGE_API_TOKEN.
#
# Development defaults are below; change before production or network use.
# ============================================================================

# Flask Dashboard
HALUNG_SECRET=replace-with-a-long-random-session-secret-here
HALUNG_ADMIN_USER=admin
HALUNG_ADMIN_PASSWORD=admin123
HALUNG_PORT=8080
HALUNG_HOST=0.0.0.0

# Edge Agent API Token (shared secret between Dashboard and Raspberry)
# Used by Raspberry to authenticate heartbeat, config requests, and cycle reports.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
HALUNG_EDGE_API_TOKEN=replace-with-a-long-random-edge-token-here

# Database
HALUNG_DB_PATH=data/halung.db

# Security
# Set to 1 only when HTTPS is enabled in front of Flask (e.g., via nginx, Caddy).
HALUNG_COOKIE_SECURE=0

# NAS and reports (optional)
HALUNG_NAS_ENABLED=0
HALUNG_NAS_PATH=
HALUNG_NAS_RETRY_MINUTES=5

# Backup
HALUNG_BACKUP_ENABLED=1
HALUNG_BACKUP_INTERVAL_MINUTES=60
HALUNG_BACKUP_RETENTION_DAYS=30

# Station health monitoring
HALUNG_STATION_OFFLINE_SECONDS=15

# Update center (optional)
HALUNG_UPDATE_SOURCE=
HALUNG_UPDATE_AUTO_CHECK=1
HALUNG_UPDATE_CHECK_INTERVAL_MINUTES=360
